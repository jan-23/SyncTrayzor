<Window x:Class="SyncTrayzor.Pages.SelectiveSync.SelectiveSyncView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SyncTrayzor.Pages.SelectiveSync"
        xmlns:s="https://github.com/canton7/Stylet"
        xmlns:l="clr-namespace:SyncTrayzor.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SelectiveSyncViewModel}"
        Title="{Binding DisplayName}" Height="450" Width="520"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{x:Static l:Localizer.FlowDirection}">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Text="{Binding DirectoryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryName}"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,5,0,10" TextWrapping="Wrap" Text="{l:Loc SelectiveSyncView_Description}"/>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="DarkOrange" Text="{l:Loc SelectiveSyncView_RemovalUnsupported}"
                   Visibility="{Binding CanRemove, Converter={x:Static s:BoolToVisibilityConverter.InverseInstance}}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button MinWidth="80" Padding="10,2" IsDefault="True" Command="{s:Action Apply}" Content="{l:Loc SelectiveSyncView_Apply}"/>
            <Button MinWidth="80" Padding="10,2" Margin="10,0,0,0" IsCancel="True" Command="{s:Action Close}" Content="{l:Loc SelectiveSyncView_Close}"/>
        </StackPanel>

        <Grid>
            <TextBlock Text="{l:Loc SelectiveSyncView_Loading}"
                       Visibility="{Binding IsLoading, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"/>
            <TextBlock Text="{l:Loc SelectiveSyncView_NoSubfolders}"
                       Visibility="{Binding HasNoSubfolders, Converter={x:Static s:BoolToVisibilityConverter.Instance}}"/>
            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>
            <ListBox ItemsSource="{Binding Subfolders}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding HasSubfolders, Converter={x:Static s:BoolToVisibilityConverter.Instance}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding IsSynced}" IsEnabled="{Binding IsEnabled}"/>
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Foreground="Gray" TextWrapping="Wrap" MaxWidth="260" Text="{Binding Status}"/>
                            <TextBlock Margin="5,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
